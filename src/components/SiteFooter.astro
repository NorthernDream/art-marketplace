---
// 页脚四栏。尚未建立的目标页（live: false）不渲染成链接，而是像主导航里的
// Photography / Sculpture 一样标一枚 Coming soon——把访客送到一个 404 上，
// 比老实承认这页还没做要难看得多。
import { FOOTER_COLUMNS, DECORATIVE_LINKS } from '../lib/nav';

// 法务页（Terms / Privacy / Cookies）在 Phase 4 才建。与页脚其他未建页面
// 同等对待：不渲染成链接，标 Coming soon。不因为是法务页就特殊处理。
// 清单见 lib/nav.ts 的 DECORATIVE_LINKS。
const LEGAL_LINKS = DECORATIVE_LINKS
  .filter((d) => d.where === 'SiteFooter')
  .map((d) => d.label);
---
<footer class="site">
  <div class="wrap">
    <div class="fcols">
      {FOOTER_COLUMNS.map((col) => (
        <div>
          <h2>{col.title}</h2>
          <ul>
            {col.links.map((link) => (
              <li>
                {link.live ? (
                  <a href={link.href}>{link.label}</a>
                ) : (
                  <span class="soon">{link.label} <span class="tag">Coming soon</span></span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="fbot">
      <span>&copy; 2026 VELIN Art</span>
      {LEGAL_LINKS.map((label) => (
        <span class="soon">{label} <span class="tag">Coming soon</span></span>
      ))}
      {/* 原文只覆盖 artworks / artists / prices，不覆盖促销码、运费、退货与
          真伪证书这些政策主张，而页面上到处都是。范围扩到「样例」二字管得住的地方。 */}
      <span class="note">Prototype. Artworks, artists, prices, offers and policies shown are fictional samples.</span>
    </div>
  </div>
</footer>

<style>
  footer.site {
    border-top: 1px solid var(--line);
    background: var(--surface);
    margin-top: 0;
    padding: 52px 0 26px;
  }
  .fcols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
  }
  .fcols h2 {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 14px;
    color: var(--ink);
  }
  .fcols ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  /* 触控目标：13px/20px 行高的链接原来只有 17px 高，加 12px 上下内边距到 44px。
     行距从 ul 的 gap 移进 padding，视觉节奏基本不变，代价是每栏高约 60px。
     这一处不能用透明热区：链接密排，44px 的热区会互相重叠，点谁都不确定。 */
  .fcols a,
  .fcols .soon {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: 13px;
    line-height: 20px;
  }
  .fcols a {
    color: var(--ink-2);
  }
  .fcols a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .fcols .soon {
    gap: 7px;
    color: var(--ink-3);
  }
  .fcols .tag {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 1px 5px;
    white-space: nowrap;
  }
  .fbot {
    margin-top: 44px;
    padding-top: 20px;
    border-top: 1px solid var(--line-2);
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    align-items: center;
    font-size: 11.5px;
    color: var(--ink-3);
  }
  .fbot .note {
    margin-left: auto;
    text-align: right;
  }
  .fbot .soon {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .fbot .tag {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 1px 5px;
    white-space: nowrap;
  }

  @media (max-width: 1080px) {
    .fcols {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 620px) {
    .fcols {
      grid-template-columns: 1fr;
    }
  }
</style>
