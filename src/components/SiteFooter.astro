---
// 页脚四栏。尚未建立的目标页（live: false）不渲染成链接，而是像主导航里的
// Photography / Sculpture 一样标一枚 Coming soon——把访客送到一个 404 上，
// 比老实承认这页还没做要难看得多。
import { FOOTER_COLUMNS } from '../lib/nav';
---
<footer class="site">
  <div class="wrap">
    <div class="fcols">
      {FOOTER_COLUMNS.map((col) => (
        <div>
          <h4>{col.title}</h4>
          <ul>
            {col.links.map((link) => (
              <li>
                {link.live ? (
                  <a href={link.href}>{link.label}</a>
                ) : (
                  <span class="soon">{link.label} <span class="tag">Coming soon</span></span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="fbot">
      <span>&copy; 2026 VELIN Art</span>
      <a href="#">Terms</a><a href="#">Privacy</a><a href="#">Cookies</a>
      <span class="note">Prototype. Artworks, artists and prices shown are fictional samples.</span>
    </div>
  </div>
</footer>

<style>
  footer.site {
    border-top: 1px solid var(--line);
    background: var(--surface);
    margin-top: 0;
    padding: 52px 0 26px;
  }
  .fcols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
  }
  .fcols h4 {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 14px;
    color: var(--ink);
  }
  .fcols ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 9px;
  }
  .fcols a {
    font-size: 13px;
    color: var(--ink-2);
  }
  .fcols a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .fcols .soon {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    color: var(--ink-3);
  }
  .fcols .tag {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 1px 5px;
    white-space: nowrap;
  }
  .fbot {
    margin-top: 44px;
    padding-top: 20px;
    border-top: 1px solid var(--line-2);
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    align-items: center;
    font-size: 11.5px;
    color: var(--ink-3);
  }
  .fbot .note {
    margin-left: auto;
    text-align: right;
  }

  @media (max-width: 1080px) {
    .fcols {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 620px) {
    .fcols {
      grid-template-columns: 1fr;
    }
  }
</style>
