---
import { PRIMARY_NAV } from '../lib/nav';

// build.format 为 'directory' 时非首页路径带末尾斜杠（如 /paintings/），
// 归一化后再与 nav 的 href 比较，否则 aria-current 永远命中不了品类页
const rawPath = Astro.url.pathname;
const currentPath = rawPath !== '/' && rawPath.endsWith('/') ? rawPath.slice(0, -1) : rawPath;
---
<header class="site">
  <div class="wrap">
    <div class="bar">
      <a href="/" class="mark">VELIN<span>Original Art</span></a>
      <form class="search" id="site-search" role="search" action="/paintings/" method="get">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        <input type="search" name="q" placeholder="Search works, artists, styles" aria-label="Search artworks" />
      </form>
      <!--
        Sign In / Favorites / Cart 要到 Phase 3 才有落地页（spec §9 的
        localStorage 状态层）。原来它们是 href="#" 的死链，点了什么都不发生。
        改成非链接元素：图标与购物车 0 徽标保留（它们表达「这是一个市场」
        这件事），但不再伪装成可点。清单见 lib/nav.ts 的 DECORATIVE_LINKS，
        spec §12 要求装饰性链接必须列明。
        头部横向空间放不下可见的 Coming soon 文字标签，与页脚的处理方式不同。
      -->
      <div class="acts" aria-hidden="true">
        <span class="act">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="3.4"/><path d="M4.5 20c1.2-3.6 4-5.4 7.5-5.4S18.3 16.4 19.5 20"/></svg>
          <span class="lbl">Sign In</span>
        </span>
        <span class="act">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 20s-7-4.4-7-9a4 4 0 017-2.6A4 4 0 0119 11c0 4.6-7 9-7 9z"/></svg>
          <span class="lbl">Favorites</span>
        </span>
        <span class="act">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 7h14l-1.2 12.2a1.6 1.6 0 01-1.6 1.4H7.8a1.6 1.6 0 01-1.6-1.4z"/><path d="M9 9V6.5a3 3 0 016 0V9"/></svg>
          <span class="lbl">Cart</span>
          <span class="badge num">0</span>
        </span>
      </div>
    </div>
  </div>
  <nav class="cats" aria-label="Categories">
    <div class="wrap">
      <ul>
        {PRIMARY_NAV.map((item) => (
          item.live ? (
            <li>
              <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>
            </li>
          ) : (
            <li class="soon">{item.label} <span class="tag">Coming soon</span></li>
          )
        ))}
      </ul>
    </div>
  </nav>
</header>

<script>
  // 吸顶偏移一直靠手写的 --header-h: 110px 撑着，而头部高度会随断点和内容
  // 换行而变（窄屏搜索另起一行就是一例）。这里按实测高度写回该变量，
  // 结果栏、筛选栏、详情页三处 sticky 偏移随之自动跟上，不必再各自猜数字。
  // CSS 里的 110px 仍作为脚本执行前的默认值保留。
  const header = document.querySelector<HTMLElement>('header.site');
  if (header) {
    const sync = () => {
      const h = Math.round(header.getBoundingClientRect().height);
      if (h > 0) document.documentElement.style.setProperty('--header-h', `${h}px`);
    };
    sync();
    if (typeof ResizeObserver !== 'undefined') new ResizeObserver(sync).observe(header);
    else window.addEventListener('resize', sync);
    // 网页字体换上后行高会变，头部高度跟着变一次
    document.fonts?.ready.then(sync);
  }
</script>

<style>
  header.site {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 64px;
  }
  .mark {
    font-family: var(--f-display);
    font-size: 25px;
    letter-spacing: 0.22em;
    padding-right: 4px;
    white-space: nowrap;
  }
  .mark span {
    display: block;
    font-family: var(--f-ui);
    font-size: 8.5px;
    letter-spacing: 0.3em;
    color: var(--ink-2);
    margin-top: -4px;
  }
  .search {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 9px;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    padding: 0 12px;
    height: 36px;
    background: var(--paper);
    max-width: 420px;
  }
  .search input {
    border: 0;
    background: none;
    font-family: inherit;
    /* 必须 ≥16px：iOS 上字号小于 16px 的输入框一聚焦就会把整页放大，
       放大后页面位移、吸顶元素错位，而且退出输入也不会自动缩回去。 */
    font-size: 16px;
    width: 100%;
    color: var(--ink);
  }
  .search input::placeholder {
    color: var(--ink-3);
  }
  /* 原来这里是 outline:none 且没有任何替代，实测聚焦后 outline 与 boxShadow
     都是 none——头部唯一的输入框，键盘用户看不到自己在哪。焦点环画在外框上
     而不是 input 上，因为用户看到的边界是 .search 这个盒子。 */
  .search:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .acts {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .act {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12.5px;
    color: var(--ink-2);
  }
  .badge {
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 8px;
    background: var(--accent);
    color: var(--surface);
    font-size: 10px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .cats {
    border-top: 1px solid var(--line-2);
  }
  .cats ul {
    display: flex;
    gap: 30px;
    list-style: none;
    margin: 0;
    padding: 0;
    height: 44px;
    align-items: center;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .cats ul::-webkit-scrollbar {
    display: none;
  }
  .cats a {
    font-size: 12.5px;
    white-space: nowrap;
    color: var(--ink-2);
    border-bottom: 2px solid transparent;
    height: 44px;
    display: flex;
    align-items: center;
  }
  .cats a:hover {
    color: var(--ink);
  }
  .cats a[aria-current] {
    color: var(--ink);
    font-weight: 600;
    border-bottom-color: var(--ink);
  }
  .cats .soon {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12.5px;
    white-space: nowrap;
    color: var(--ink-3);
    height: 44px;
  }
  .cats .tag {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-3);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 2px 6px;
  }

  /* .cats ul 是横向滚动区且滚动条被藏起来了。390px 下 Photography 被从中间
     切断、Sculpture 完全在屏外，而用户没有任何线索知道右边还有内容。
     右缘压一层渐隐，提示「还有」。遮罩不拦点击。 */
  .cats {
    position: relative;
  }
  .cats::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 36px;
    height: 100%;
    pointer-events: none;
    background: linear-gradient(to right, transparent, var(--surface));
  }
  @media (min-width: 901px) {
    /* 宽屏放得下全部品类，不需要提示 */
    .cats::after {
      display: none;
    }
  }

  /* 窄屏放不下「标志 + 搜索 + 三个图标」一行，但搜索不能像以前那样直接藏掉
     ——那样手机上就完全没法搜。改成让 .bar 换行，搜索独占第二行铺满宽度。
     头部因此变高，吸顶偏移由上面的脚本按实测高度写回 --header-h，不写死数字。 */
  @media (max-width: 900px) {
    .bar {
      height: auto;
      flex-wrap: wrap;
      gap: 10px 16px;
      padding: 8px 0;
    }
    .search {
      order: 3;
      flex-basis: 100%;
      max-width: none;
    }
  }
  /* 实测头部曾占 390×844 视口的 19%。.cats 的 44px 是触控目标下限、
     搜索框的 36px 压到 34 以下 iOS 会触发输入缩放，两者都不能动，
     于是从字标和留白上要空间：字标收小、副行「Original Art」隐去。
     目标 ≤136px（16%）。 */
  @media (max-width: 620px) {
    .acts .lbl {
      display: none;
    }
    .acts {
      gap: 18px;
    }
    .mark {
      font-size: 21px;
      /* 不设的话会继承 body 的无单位 line-height:1.5，单行的 wordmark
         用不上这行高，却在这个头部已是最大固定元素的视口里白吃 7px。 */
      line-height: 1.15;
    }
    .mark span {
      display: none;
    }
  }
</style>
