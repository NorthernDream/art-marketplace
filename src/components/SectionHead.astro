---
// 迁移自原型的 .sechead：小节标题 + 可选说明文字 + 可选的右对齐链接。
// 首页除 Hero/Trust/Room band 外的每个小节抬头都复用这一份实现。
interface Props {
  title: string;
  blurb?: string;
  linkLabel?: string;
  linkHref?: string;
}

const { title, blurb, linkLabel, linkHref } = Astro.props;
---
<div class="sechead">
  <h2>{title}</h2>
  {blurb && <p>{blurb}</p>}
  {linkLabel && linkHref && (
    <a class="link" href={linkHref}>{linkLabel}</a>
  )}
</div>

<style>
  .sechead {
    display: flex;
    align-items: baseline;
    gap: 18px;
    margin-bottom: 26px;
    flex-wrap: wrap;
  }
  .sechead h2 {
    font-family: var(--f-display);
    font-weight: 400;
    font-size: 29px;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .sechead p {
    margin: 0;
    color: var(--ink-2);
    font-size: 13.5px;
    max-width: 46ch;
  }
  .link {
    margin-left: auto;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 2px;
    white-space: nowrap;
  }
</style>
