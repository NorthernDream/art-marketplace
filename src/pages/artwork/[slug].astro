---
// 作品详情页：迁移自原型的 detailView()。120 件作品各生成一个静态页面。
//
// 与原型的一处刻意偏差：原型的"相关作品"用 subject===a.su || style===a.st 匹配，
// 但小节标题只写了 "More {subject} works"——标题和实际取到的作品对不上。这里改成
// 只按 subject 匹配，让标题与内容一致，也符合任务说明里"同题材相关作品"的要求。
import Base from '../../layouts/Base.astro';
import ArtworkGrid from '../../components/ArtworkGrid.astro';
import ViewInRoom from '../../components/ViewInRoom.astro';
import { ARTWORKS, artworkBySlug } from '../../lib/data/artworks';
import { ARTISTS, artistById } from '../../lib/data/artists';
import { buildCatalog, orientation, relatedWorks } from '../../lib/catalog';
import { usd, dimensions } from '../../lib/format';
import { placeholderColor } from '../../lib/art/render';
import type { Category } from '../../lib/data/types';

export function getStaticPaths() {
  return ARTWORKS.map((artwork) => ({ params: { slug: artwork.slug } }));
}

const { slug } = Astro.params;
const artwork = artworkBySlug(slug!);
if (!artwork) {
  // getStaticPaths 与 ARTWORKS 同源，理论上不会走到这里
  throw new Error(`未找到 slug 为 "${slug}" 的作品`);
}
const artist = artistById(artwork.artistId);
if (!artist) {
  throw new Error(`作品 ${artwork.id} 指向不存在的艺术家 ${artwork.artistId}`);
}

const CATEGORY_META: Record<Category, { label: string; href: string }> = {
  painting: { label: 'Paintings', href: '/paintings' },
  drawing: { label: 'Drawings', href: '/drawings' },
  print: { label: 'Prints', href: '/prints' }
};
const category = CATEGORY_META[artwork.category];

const packaging =
  Math.max(artwork.widthIn, artwork.heightIn) > 48 ? 'Rolled in a tube' : 'Ready to hang, stretched';

const catalog = buildCatalog(ARTWORKS, ARTISTS);
const self = catalog.find((item) => item.id === artwork.id)!;
const related = relatedWorks(catalog, self, 4);
---
<Base title={`${artwork.title} — VELIN`} description={artwork.statement}>
  <div class="wrap detail" data-artwork-page>
    <p class="crumbs">
      <a href="/">Home</a> / <a href={category.href}>{category.label}</a> / {artwork.title}
    </p>
    <a class="back" href={category.href}>&larr; Back to {category.label}</a>

    <div class="dgrid">
      <div>
        <div class="tabs" role="tablist">
          <button type="button" class="tab" role="tab" id="tab-artwork" data-tab="artwork" aria-selected="true" aria-controls="panel-artwork">Artwork</button>
          <button type="button" class="tab" role="tab" id="tab-room" data-tab="room" aria-selected="false" aria-controls="panel-room">View in a Room</button>
        </div>

        <div id="panel-artwork" role="tabpanel" aria-labelledby="tab-artwork">
          <div class="stage" data-pad="44">
            <canvas id="bigArt" style={`background:${placeholderColor(artwork)}`}></canvas>
          </div>
          <div class="caption">
            <span class="num">{dimensions(artwork.widthIn, artwork.heightIn)}</span>
            <span>{artwork.medium}, {artwork.year}</span>
            <span>Signed front and reverse</span>
          </div>
        </div>

        <div id="panel-room" role="tabpanel" aria-labelledby="tab-room" hidden>
          <ViewInRoom artwork={artwork} />
        </div>

        <div class="about">
          <h3>About this work</h3>
          <p>{artwork.statement}</p>
        </div>
      </div>

      <div class="dpanel">
        <span class="eyebrow">{artwork.subject} &middot; {artwork.style}</span>
        <h2><em>{artwork.title}</em></h2>
        <p class="byline">by <a href={`/artist/${artist.slug}/`}>{artist.name}</a>, {artist.country}</p>
        <div class="price">
          <span class="v num">{usd(artwork.priceUsd)}</span>
          <span class="n">Shipping &amp; VAT included</span>
        </div>
        <p class="stock">
          {artwork.edition ? (
            <><b>Limited edition</b> &middot; No. {artwork.edition.n} of {artwork.edition.of}</>
          ) : (
            <><b>Original</b> &middot; 1 of 1, only one available</>
          )}
        </p>
        <div class="buys">
          <button type="button" class="btn solid" id="addCart">Add to Cart</button>
          <button type="button" class="btn" id="offer">Make an Offer</button>
        </div>
        <dl class="spec">
          <div><dt>Medium</dt><dd>{artwork.medium}</dd></div>
          <div><dt>Size</dt><dd class="num">{dimensions(artwork.widthIn, artwork.heightIn)}</dd></div>
          <div><dt>Orientation</dt><dd>{orientation(artwork.widthIn, artwork.heightIn)}</dd></div>
          <div><dt>Year</dt><dd class="num">{artwork.year}</dd></div>
          <div><dt>Subject</dt><dd>{artwork.subject}</dd></div>
          <div><dt>Style</dt><dd>{artwork.style}</dd></div>
          <div><dt>Packaging</dt><dd>{packaging}</dd></div>
        </dl>
        <ul class="assure">
          <li>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 12.5l5 5L20 6.5"></path></svg>
            <span>Certificate of authenticity, signed by the artist</span>
          </li>
          <li>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 12.5l5 5L20 6.5"></path></svg>
            <span>Free worldwide shipping, fully insured in transit</span>
          </li>
          <li>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 12.5l5 5L20 6.5"></path></svg>
            <span>14-day returns &mdash; refund if it isn&rsquo;t right on the wall</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="related">
      <h3>More {artwork.subject.toLowerCase()} works</h3>
      <ArtworkGrid items={related} />
    </div>
  </div>

  <div id="toast" role="status" aria-live="polite"></div>
</Base>

<script>
  import { initArtworkPage } from '../../scripts/artwork-page';

  const raw = document.getElementById('artwork-data')?.textContent ?? 'null';
  const artwork = JSON.parse(raw);
  if (artwork) initArtworkPage(artwork);
</script>
<script type="application/json" id="artwork-data" set:html={JSON.stringify(artwork).replace(/</g, '\\u003c')} />

<style>
  .detail {
    /* .detail 与 .wrap 同挂在一个元素上，这里的简写会连左右内边距一起重置掉，
       且作用域选择器的优先级高过 .wrap，页面就整块贴到视口边缘了——
       左右必须显式写回 --gut，和头部/页脚对齐。 */
    padding: 24px var(--gut) 80px;
  }
  /* .crumbs 的排版在 styles/base.css 里，详情页只把下边距收窄一点 */
  .crumbs {
    margin-bottom: 10px;
  }
  .back {
    font-size: 12.5px;
    color: var(--ink-2);
    display: inline-flex;
    gap: 7px;
    align-items: center;
    margin-bottom: 22px;
  }
  .back:hover {
    color: var(--ink);
  }
  .dgrid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 366px;
    gap: 56px;
    align-items: start;
  }
  .tabs {
    display: flex;
    gap: 26px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 22px;
  }
  .tab {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    padding: 0 0 11px;
    border-bottom: 2px solid transparent;
  }
  .tab[aria-selected='true'] {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }
  .stage {
    background: var(--paper);
    border: 1px solid var(--line-2);
    min-height: 520px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 44px;
  }
  .stage canvas {
    box-shadow:
      0 2px 0 color-mix(in srgb, var(--ink) 24%, transparent),
      10px 16px 40px color-mix(in srgb, var(--ink) 18%, transparent);
  }
  /* .caption 的排版在 styles/base.css 里，与 ViewInRoom 的房间说明行共用 */
  .about {
    margin-top: 38px;
    max-width: 62ch;
  }
  .about h3 {
    font-family: var(--f-display);
    font-weight: 400;
    font-size: 20px;
    margin: 0 0 10px;
  }
  .about p {
    color: var(--ink-2);
    line-height: 1.65;
    margin: 0 0 12px;
  }

  .dpanel {
    position: sticky;
    top: calc(var(--header-h) + 14px);
  }
  .dpanel h2 {
    font-family: var(--f-display);
    font-weight: 400;
    font-size: 31px;
    line-height: 1.1;
    margin: 6px 0 6px;
    letter-spacing: -0.01em;
  }
  .dpanel h2 em {
    font-family: var(--f-title);
    font-style: italic;
  }
  .byline {
    font-size: 14px;
    color: var(--ink-2);
    margin: 0 0 20px;
  }
  .price {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 0 0 4px;
  }
  .price .v {
    font-size: 26px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .price .n {
    font-size: 12px;
    color: var(--ink-3);
  }
  .stock {
    font-size: 12px;
    color: var(--ink-2);
    margin: 0 0 20px;
  }
  .stock b {
    color: var(--ink);
    font-weight: 600;
  }
  .buys {
    display: grid;
    gap: 10px;
    margin-bottom: 26px;
  }
  /* .btn / .btn.solid 的样式在 styles/base.css 里，这里只留详情页的加宽 */
  .buys .btn {
    width: 100%;
    padding: 15px;
  }
  .spec {
    border-top: 1px solid var(--line);
    padding-top: 18px;
    display: grid;
    gap: 0;
    margin: 0;
  }
  .spec div {
    display: flex;
    gap: 16px;
    padding: 8px 0;
    border-bottom: 1px solid var(--line-2);
    font-size: 13px;
  }
  .spec dt {
    width: 112px;
    flex: none;
    color: var(--ink-3);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding-top: 2px;
  }
  .spec dd {
    margin: 0;
    color: var(--ink);
  }
  .assure {
    list-style: none;
    padding: 0;
    margin-top: 22px;
    display: grid;
    gap: 9px;
  }
  .assure li {
    display: flex;
    gap: 9px;
    font-size: 12.5px;
    color: var(--ink-2);
    align-items: flex-start;
  }
  .assure svg {
    flex: none;
    margin-top: 2px;
    color: var(--accent);
  }

  .related {
    padding-top: 56px;
    margin-top: 56px;
    border-top: 1px solid var(--line);
  }
  .related h3 {
    font-family: var(--f-display);
    font-weight: 400;
    font-size: 23px;
    margin: 0 0 26px;
  }

  #toast {
    position: fixed;
    left: 50%;
    bottom: 32px;
    transform: translate(-50%, 20px);
    z-index: 80;
    background: var(--ink);
    color: var(--paper);
    padding: 12px 20px;
    font-size: 13px;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }
  #toast.on {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (max-width: 1080px) {
    .dgrid {
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: 36px;
    }
  }
  @media (max-width: 900px) {
    .dgrid {
      grid-template-columns: minmax(0, 1fr);
    }
    .dpanel {
      position: static;
    }
  }
  @media (max-width: 620px) {
    .stage {
      padding: 18px;
      min-height: 340px;
    }
  }
</style>
